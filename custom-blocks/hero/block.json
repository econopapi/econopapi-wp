{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "econopapi/hero",
  "version": "1.0.0",
  "title": "Econopapi Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Bloque hero para la front page de Econopapi.",
  "textdomain": "econopapi-wp",
  "keywords": ["hero", "front page", "econopapi"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "tagline": { "type": "string", "default": "ECONOMISTA · DESARROLLADOR" },
    "title": { "type": "string", "default": "Datos, código y economía — desde México." },
    "description": {
      "type": "string",
      "default": "Escribo sobre el cruce entre tecnología, datos y economía. Construyo herramientas con Python, PHP y todo lo que tenga sentido."
    },
    "primaryButtonLabel": { "type": "string", "default": "Leer el blog" },
    "primaryButtonUrl": { "type": "string", "default": "/blog" },
    "secondaryButtonLabel": { "type": "string", "default": "Ver proyectos" },
    "secondaryButtonUrl": { "type": "string", "default": "/proyectos" }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
