{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "econopapi/profile-card",
  "version": "1.0.0",
  "title": "Econopapi Profile Card",
  "category": "widgets",
  "icon": "id",
  "description": "Tarjeta de perfil premium para mostrar identidad, contacto y enlaces.",
  "textdomain": "econopapi-wp",
  "keywords": ["profile", "card", "about", "bio", "econopapi"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "fullName": { "type": "string", "default": "Daniel Limón" },
    "username": { "type": "string", "default": "@econopapi" },
    "role": { "type": "string", "default": "Economista · Desarrollador" },
    "cardVariant": { "type": "string", "default": "gradient" },
    "locationLabel": { "type": "string", "default": "Basado en" },
    "location": { "type": "string", "default": "México" },
    "showEmail": { "type": "boolean", "default": true },
    "email": { "type": "string", "default": "" },
    "showGithub": { "type": "boolean", "default": true },
    "githubUrl": { "type": "string", "default": "" },
    "githubLabel": { "type": "string", "default": "GitHub" },
    "showLinkedin": { "type": "boolean", "default": true },
    "linkedinUrl": { "type": "string", "default": "" },
    "linkedinLabel": { "type": "string", "default": "LinkedIn" },
    "showYoutube": { "type": "boolean", "default": true },
    "youtubeUrl": { "type": "string", "default": "" },
    "youtubeLabel": { "type": "string", "default": "YouTube" },
    "avatarUrl": { "type": "string", "default": "" },
    "avatarAlt": { "type": "string", "default": "" },
    "avatarInitials": { "type": "string", "default": "DL" },
    "showGlassEffect": { "type": "boolean", "default": true }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
